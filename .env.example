# -----------------------------------------------------------------------------
# VELTRIX STUDIO ads bot — environment variables
# -----------------------------------------------------------------------------

# توکن ربات جدید تبلیغات (از @BotFather). حتماً یک ربات جدا بساز.
ADS_BOT_TOKEN=

# شناسهٔ تلگرام مدیر (خودت) — پنل مدیریت تبلیغات فقط برای این ID فعال است.
ADMIN_TELEGRAM_IDS=8917877282

# کانالی که پست‌های تبلیغاتی در آن منتشر می‌شود.
ADS_CHANNEL_ID=@VeeltrixStudio

# فاصلهٔ پست‌های خودکار به دقیقه (پیش‌فرض: ۱۸۰ = هر ۳ ساعت).
ADS_INTERVAL_MINUTES=180

# ربات اصلی که دکمه‌های تبلیغ به آن هدایت می‌شوند (بدون @).
MAIN_BOT_USERNAME=VeltrixStudio_bot

TELEGRAM_CHANNEL_URL=https://t.me/VeeltrixStudio
TELEGRAM_SUPPORT_URL=https://t.me/ImAmirh3ein
SITE_URL=https://veltrixstudio.com
INSTAGRAM_URL=https://instagram.com/veltrixstudio
CONTACT_EMAIL=hello@veltrixstudio.com
BRAND_NAME=VELTRIX STUDIO
